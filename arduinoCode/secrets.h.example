#pragma once

/* Copy this file to secrets.h (already in .gitignore -- never commit the
   real one) and fill in a real token before building/flashing locally.

   Generate a fine-grained GitHub Personal Access Token scoped to ONLY this
   repository (Firmware-HRMS), with repository permission
   "Contents: Read-only" and nothing else. Every device flashed with this
   firmware carries this same token baked into its binary, so keep the scope
   as narrow as possible and rotate it if a device is ever lost or opened up.

   CI (.github/workflows/release-firmware.yml) generates its own secrets.h
   from the DEVICE_OTA_PAT repository secret at build time, so official
   releases don't rely on this file -- it's only needed for local builds. */
#define GITHUB_PAT "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
